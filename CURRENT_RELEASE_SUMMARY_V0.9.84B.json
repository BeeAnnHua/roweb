{
  "project": "彼岸花仙境 / RO_WEB",
  "version": "V0.9.84B",
  "base": "V0.9.83E3 + V0.9.84A Supabase registration verification",
  "release_type": "incremental_patch",
  "features": [
    "formal_player_cloud_account_ui",
    "email_otp_registration_and_password_recovery",
    "12_character_slots_per_game_account",
    "character_slot_move_and_swap",
    "local_browser_character_to_supabase_migration",
    "remote_character_save_adapter",
    "per_account_shared_storage_cloud_sync",
    "player_facing_debug_information_removed"
  ],
  "safety": {
    "local_character_save_deleted_after_migration": false,
    "indexeddb_backup_preserved": true,
    "remote_newer_save_overwrite_guard": true
