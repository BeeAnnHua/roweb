    "shared_storage": "ro_accounts.shared_save.account_storage"
  },
  "player_account_rules": {
    "accounts_per_email": 5,
    "slots_per_account": 12,
    "reserved_gm_player_ids": "100001-100009",
    "normal_player_id_start": 100010
  }
