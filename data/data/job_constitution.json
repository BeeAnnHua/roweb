  "policy": {
    "constitutionIsHighestRule": true,
    "noCoreChangeForNewJobs": true,
    "allJobChangesUseConstitution": true,
    "singleEntryPoint": "changeJob() -> validateJobConstitution()",
    "doNotAddDirectNonRebirthThirdRoute": true,
    "note": "RO_WEB 一般職業不採用 RA jobmaster 內未轉生直升三轉路線，也不採一般二轉 Job40；一般/進階二轉固定 Job50。其餘等級與 Job 上限依專案入口 RA DB_re。",
    "normalSecondJob50Required": true,
    "normalTransSecondJob50Required": true,
    "raSecondJob40ExcludedForNormalClass": true
  },
  "commonRequirements": {
    "requireAllSkillPointsSpent": true,
    "skillPointRule": "所有職業、所有階段、一般/轉生/擴充職業，只要剩餘技能點數 > 0 或有暫存技能點未確認，就不可轉職。",
    "statusPointRule": "一般轉職不檢查剩餘素質點；轉生固定重置，不繼承舊剩餘點。",
