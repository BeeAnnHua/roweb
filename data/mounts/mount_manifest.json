      "toggleSkillId": 63,
      "allowedJobs": [
        "rune_knight",
        "dragon_knight"
      ],
      "carryingCapacityBonus": 0,
      "rentalEnabled": false,
      "assetStatus": "pending_swordman_mount_assets",
      "note": "需學會龍駕馭；龍息、龍之咆哮與龍威氣息要求騎龍。RO_WEB 不增加負重量。"
    },
    "griffon": {
      "mountType": "griffon",
      "displayName": "獅鷲坐騎",
